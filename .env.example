NEXT_PUBLIC_SITE_URL=

# Public Supabase project credentials — safe to expose to the browser.
# RLS policies (see supabase/migrations/) restrict what the anon key can read/write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import from client code,
# and never commit a real value. Only used locally to run scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used to email an admin notification when a customer places a
# new order (see src/lib/email/). Never commit a real value.
RESEND_API_KEY=

# Server-only. WhatsApp Cloud API credentials (Meta Business Manager > your
# app > WhatsApp > API Setup). Never commit real values.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Admin-facing "new order placed" alert (src/lib/whatsapp/orderNotification.ts).
# WHATSAPP_ADMIN_NUMBER is your own WhatsApp number, in international format
# with no "+" (e.g. 923001234567).
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_TEMPLATE_NAME=new_order_alert

# Customer-facing COD order confirmation request with a tappable "Confirm
# Order" button (src/lib/whatsapp/orderConfirmation.ts) -- see that file's
# doc comment for the exact template text to submit for approval in Meta
# Business Manager.
WHATSAPP_ORDER_CONFIRMATION_TEMPLATE_NAME=order_confirmation_cod

# Inbound webhook that auto-confirms an order when the customer taps
# "Confirm Order" (src/app/api/whatsapp/webhook/route.ts). Register
# https://<your-domain>/api/whatsapp/webhook in Meta App Dashboard > WhatsApp
# > Configuration, using a verify token you make up here.
# WHATSAPP_APP_SECRET is under App Dashboard > Settings > Basic > App Secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Server-only. Meta Conversions API token for the Purchase event
# (src/lib/meta/conversionsApi.ts) -- sends order data straight from the
# server, so it isn't lost to iOS/Safari tracking prevention and ad blockers
# the way the browser-only Pixel call is. Generate under Meta Events
# Manager > Data Sources > [the pixel named in src/constants/meta.ts] >
# Settings > Conversions API > Generate Access Token. Without this set, the
# server-side call is silently skipped and only the browser Pixel fires --
# checkout itself is never affected either way.
META_CONVERSIONS_API_ACCESS_TOKEN=

# Server-only. TikTok for Developers app credentials (developers.tiktok.com,
# org "ZOQ,s Gallery") for the Content Posting API Direct Post integration
# (src/lib/tiktok/). TIKTOK_ENV picks which client key/secret pair the OAuth
# routes use -- keep it "sandbox" until TikTok approves the app for review,
# since an unaudited app can only post (as private/self-view) to sandbox
# target accounts registered in the portal's Sandbox > Target Users list.
TIKTOK_ENV=sandbox
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
TIKTOK_PRODUCTION_CLIENT_KEY=
TIKTOK_PRODUCTION_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Login Kit product in
# both the Production and Sandbox app configs in the TikTok developer portal.
TIKTOK_REDIRECT_URI=
